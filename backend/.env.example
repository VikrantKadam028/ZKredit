# Copy to .env (or export these directly) for local (non-Docker) dev.
# In Docker, these are set in docker-compose.yml instead — see root README.

# JWT signing key — MUST be a long random string in any real deployment.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-secret-change-in-production

# Google OAuth Client ID (Web application type) from
# https://console.cloud.google.com/apis/credentials
# Leave blank to disable Google sign-in (email/password still works).
GOOGLE_CLIENT_ID=

# Defaults to sqlite:///./zkredit.db if unset — only needed if you want to
# point local dev at a real Postgres instance too.
# DATABASE_URL=postgresql://zkredit:zkredit_dev_password@localhost:5432/zkredit